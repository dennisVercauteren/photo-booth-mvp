# Gemini API key. Never expose this to the browser or commit the real .env file.
GEMINI_API_KEY=

# Stable image model verified against the Gemini Interactions API (October 2026).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Save generated portraits under /outputs/YYYY-MM-DD/. Originals stay off unless debugging.
SAVE_OUTPUT_IMAGES=true
SAVE_SOURCE_IMAGES=false

PORT=3001

# Optional. Maximum wait for one Gemini image response.
GEMINI_TIMEOUT_MS=120000

# Optional. 5:4 matches a 5 by 4 inch landscape print.
GEMINI_IMAGE_ASPECT_RATIO=5:4

# Optional. Final size of the portrait the guest keeps: 512, 1K, 2K, or 4K.
GEMINI_IMAGE_SIZE=2K

# Optional. Size used for the three choices. The chosen portrait is enlarged locally to GEMINI_IMAGE_SIZE.
GEMINI_PREVIEW_SIZE=1K
