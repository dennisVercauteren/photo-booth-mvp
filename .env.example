# Copy this file to server/.env
# The Gemini API key is read only by the backend. Never put it in client code.

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
SAVE_OUTPUT_IMAGES=true
SAVE_SOURCE_IMAGES=false
PORT=3001

# Optional generation settings. Defaults match these values when unset.
GEMINI_TIMEOUT_MS=120000
GEMINI_IMAGE_ASPECT_RATIO=5:4
GEMINI_IMAGE_SIZE=2K
GEMINI_PREVIEW_SIZE=1K
